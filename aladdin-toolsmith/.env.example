# aladdin-toolsmith 環境變數範本 —— 複製為 .env 並填入實際值。
#
#   cp .env.example .env
#
# 這份檔案只給 aladdin-toolsmith 自己用（launchd/run-server.sh 與 manage-tokens.ts
# 皆讀這份 repo-local .env，不讀根目錄 .env）。不進 git（見 .gitignore）。

# Bearer 認證用的共用 token。產生方式：
#   bun -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOOLSMITH_API_TOKEN=

# 監聽 port，不填則用程式內建預設值 8788（正式常駐由 launchd/run-server.sh 明講掉，
# 這裡通常不需要覆蓋，僅供 stdio/本機手動啟動時使用）
TOOLSMITH_HTTP_PORT=

# per-user token 名冊路徑，不填則用程式內建預設值
TOOLSMITH_TOKENS_PATH=

# manage-tokens.ts 核發 kit 個人 Bearer token 時，成功訊息要推播的 Telegram chat_id
TG_KIT_ADMIN_CHAT_ID=
